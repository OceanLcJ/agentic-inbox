  "narrative": {
    "northStar": "项目邮件工作台",
    "overview": "A compact Chinese workspace for reading project mail, deciding what needs attention, and reviewing processing history. The existing interface label supplies the north star: calm operational surfaces, short labels, readable records, and visible state.\n\nThe system extends Cloudflare Kumo with a persistent navigation shell and compact dashboard. Preserve its neutral surfaces, blue controls, system typography, and light/dark semantic variables. This document records the implemented workspace; `app/workspace.css`, `app/index.css`, and their corresponding components remain the source of truth.",
    "keyCharacteristics": [
      "Compact navigation and restrained, bordered surfaces.",
      "Four operational metrics with tabular numbers.",
      "Status color paired with a written label.",
      "Responsive list/detail navigation and constrained mail content."
    ],
    "rules": [
      {
        "name": "The Semantic Surface Rule",
        "body": "Use Kumo semantic variables and the workspace status pairs for workspace surfaces; preserve their light/dark behavior.",
        "section": "colors"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Keep dashboard and reading surfaces flat; use the established tonal and border hierarchy to show grouping and state.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve Kumo semantic variables and the inherited system font.",
      "**Do** retain the four-tab mobile navigation and the list/detail back path.",
      "**Do** pair status colors with text and show genuine zero and empty states.",
      "**Do** keep long mail, addresses, evidence, and pagination within their content bounds.",
      "**Do** preserve visible keyboard focus and honor reduced-motion preferences."
    ],
    "donts": [
      "**Don't** substitute decorative shadows for the workspace's border and tonal hierarchy.",
      "**Don't** use the orange Kumo text-brand token for the workspace's blue action role.",
      "**Don't** let sender-supplied mail styling redefine workspace controls or layout.",
      "**Don't** hide a selected detail's path back to its list on narrow screens."
    ]
  }
}
